# Runtime-only smoke test image: lighter base + ZED SDK runtime + pyzed.
# No CUDA dev headers, no cmake, no gcc — just Python.

ARG BASE_IMAGE
ARG L4T_MAJOR
ARG L4T_MINOR
ARG ZED_SDK_VERSION

FROM ${BASE_IMAGE}

ARG L4T_MAJOR
ARG L4T_MINOR
ARG ZED_SDK_VERSION

ENV DEBIAN_FRONTEND=noninteractive \
    LOGNAME=root

SHELL ["/bin/bash", "-c"]

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates wget less zstd udev sudo apt-transport-https \
        python3 python3-pip && \
    rm -rf /var/lib/apt/lists/*

# runtime_only + skip_tools + skip_python=0 lets the installer install pyzed on top.
RUN echo "# R${L4T_MAJOR} (release), REVISION: ${L4T_MINOR}.0" > /etc/nv_tegra_release && \
    wget -q --no-check-certificate \
        "https://download.stereolabs.com/zedsdk/${ZED_SDK_VERSION}/l4t${L4T_MAJOR}.${L4T_MINOR}/jetsons" \
        -O /tmp/ZED_SDK.run && \
    chmod +x /tmp/ZED_SDK.run && \
    /tmp/ZED_SDK.run silent runtime_only skip_drivers && \
    rm -rf /tmp/ZED_SDK.run /usr/local/zed/resources/*

RUN ln -sf /usr/lib/aarch64-linux-gnu/tegra/libv4l2.so.0 /usr/lib/aarch64-linux-gnu/libv4l2.so

COPY svo_smoke.py /build/svo_smoke.py

ENTRYPOINT ["python3", "/build/svo_smoke.py"]
